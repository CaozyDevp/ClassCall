<Window x:Class="ClassCall.Teacher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ClassCall.Teacher.ViewModels"
        xmlns:local="clr-namespace:ClassCall.Teacher.Views"
        xmlns:enums="clr-namespace:ClassCall.Core.Enums;assembly=ClassCall.Core"
        xmlns:convt="clr-namespace:ClassCall.Core.Converters;assembly=ClassCall.Core"
        xmlns:ex="clr-namespace:ClassCall.Core.Extensions;assembly=ClassCall.Core"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="教室呼叫系统" Height="620" Width="600">
    <Window.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Foreground" Value="#FF6E6E6E"/>
        </Style>

        <convt:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
        <ex:EnumBindingSource x:Key="SubjectsSource" EnumType="{x:Type enums:Subjects}"/>
        <ex:EnumBindingSource x:Key="SchoolGradesSource" EnumType="{x:Type enums:SchoolGrades}"/>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 标题栏 -->
        <StackPanel  Grid.Row="0"
                    Margin="0,0,0,10">
            <TextBlock Text="教室呼叫系统"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0 0 0 5"
                       HorizontalAlignment="Center"
                       Foreground="#FF000000"/>
            <TextBlock Text="v1.0.0 by CaozyDevp"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="Gray"/>
        </StackPanel>


        <hc:Card Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Margin="20">
                <TextBlock Text="教师信息" Style="{StaticResource SectionTitleStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="姓名"
                               Padding="0"
                               VerticalAlignment="Center"
                               Margin="12"/>
                    <TextBox Name="TeacherNameTextBox"
                             Grid.Column="1"
                             Height="30"
                             Width="180"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             Text="{Binding TeacherName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Column="2"
                               Text="科目"
                               VerticalAlignment="Center"
                               Margin="12"/>
                    <ComboBox Name="SubjectComboBox"
                              Grid.Column="3"
                              Width="180"
                              Height="30"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              SelectedItem="{Binding SelectedSubject}"
                              ItemsSource="{Binding Source={StaticResource SubjectsSource}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </hc:Card>

        <hc:Card Grid.Row="2" Margin="0,0,0,16">
            <StackPanel Margin="20">
                <TextBlock Text="发送到" Style="{StaticResource SectionTitleStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="年级"
                               VerticalAlignment="Center"
                               Margin="12"/>
                    <ComboBox Name="GradeComboBox"
                              hc:InfoElement.Title="年级"
                              Grid.Column="1"
                              Height="30"
                              Width="180"
                              HorizontalAlignment="Left"
                              SelectedItem="{Binding SelectedGrade}"
                              ItemsSource="{Binding Source={StaticResource SchoolGradesSource}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Column="2"
                               Text="班级"
                               VerticalAlignment="Center"
                               Margin="12"/>
                    <ComboBox Name="ClassroomComboBox"
                              Grid.Column="3"
                              Height="30"
                              Width="180"
                              HorizontalAlignment="Left"
                              SelectedIndex="{Binding SelectedClassroomIndex}"
                              ItemsSource="{Binding Classrooms}"/>
                </Grid>
            </StackPanel>
        </hc:Card>

        <hc:Card Grid.Row="3" Margin="0,0,0,16">
            <StackPanel Margin="20">
                <TextBlock Text="通知内容" Style="{StaticResource SectionTitleStyle}"/>
                <TextBox Height="80"
                         TextWrapping="Wrap"
                         Text="{Binding Content}"
                         MaxLength="70"
                         AcceptsReturn="True"
                         TextAlignment="Left"/>
                <TextBlock Text="提示：最多可输入70个字符"
                           Style="{StaticResource HintTextStyle}"/>
            </StackPanel>
        </hc:Card>


        <Button Grid.Row="5"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Content="广播发送"
                Width="100"
                Command="{Binding BroadcastCommand}"
                Height="32"/>
    </Grid>
</Window>
