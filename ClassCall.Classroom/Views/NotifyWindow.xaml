<Window x:Class="ClassCall.Classroom.Views.NotifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:ClassCall.Classroom.ViewModels"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClassCall.Classroom.Views"
        mc:Ignorable="d"
        Topmost="True"
        ShowInTaskbar="True"
        Width="1366"
        Height="800"
        WindowState="Maximized"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Black">
    <Window.DataContext>
        <vm:NotifyViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="134"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Border Background="#323232"
                BorderBrush="#5E5E5E"
                BorderThickness="2"
                Height="84"
                CornerRadius="42"
                Margin="80 0 80 0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="教室广播"
                           Grid.Column="0"
                           Foreground="LightGray"
                           FontSize="35"
                           Margin="58 0 0 0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SourceText}"
                           Grid.Column="1"
                           Foreground="White"
                           FontSize="35"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TimeText}"
                           Grid.Column="2"
                           Foreground="LightGray"
                           FontSize="35"
                           Margin="0 0 58 0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="{Binding ContentText}"
                   FontSize="70"
                   Margin="80 0 80 0"
                   LineHeight="110"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="White"
                   TextWrapping="Wrap"
                   TextAlignment="Center"/>

        <Button Grid.Row="2"
                Width="150"
                Command="{Binding CloseCommand}"
                Height="50"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Cursor="Hand">
            <Button.Template>
                <ControlTemplate>
                    <Border Background="#1C1C1C"
                            BorderBrush="#BBE1FF"
                            BorderThickness="2"
                            CornerRadius="25">
                        <TextBlock Text="收到"
                                   Foreground="#BBE1FF"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
